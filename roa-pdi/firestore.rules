rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single get() per evaluation — all role helpers use a let binding so
    // userDoc() (and its get() call) executes exactly once per function,
    // regardless of how many role/active checks are combined. Previously,
    // isAdminOrSW() expanded into up to 4 get() calls per rule evaluation.
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return userDoc().active == true;
    }

    function isAdmin() {
      let u = userDoc();
      return u.active == true && u.role == 'admin';
    }

    function isServiceWriter() {
      let u = userDoc();
      return u.active == true && u.role == 'service_writer';
    }

    function isTechnician() {
      let u = userDoc();
      return u.active == true && u.role == 'technician';
    }

    // 1 get() regardless of how many role values are checked
    function isAdminOrSW() {
      let u = userDoc();
      return u.active == true && (u.role == 'admin' || u.role == 'service_writer');
    }

    // ── Users ───────────────────────────────────────────────────────────────
    match /users/{uid} {
      // get: own doc or admin/SW; list: admin/SW only (no per-document uid
      // condition in the list path so Firestore can evaluate collection
      // queries unambiguously without falling back to permission-denied).
      allow get:    if isSignedIn() && (request.auth.uid == uid || isAdminOrSW());
      allow list:   if isSignedIn() && isAdminOrSW();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        // User updating their own last-login only
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── PDI Template Items ──────────────────────────────────────────────────
    match /pdi_template_items/{itemId} {
      allow read: if isSignedIn() && isActiveUser();
      allow write: if isSignedIn() && isAdminOrSW();
    }

    // ── Suggested Template Items ────────────────────────────────────────────
    match /suggested_template_items/{suggId} {
      allow read: if isSignedIn() && isAdminOrSW();
      allow create: if isSignedIn() && isActiveUser();  // any active user can suggest
      allow update: if isSignedIn() && isAdminOrSW();
      allow delete: if isAdmin();
    }

    // ── PDIs ────────────────────────────────────────────────────────────────
    match /pdis/{pdiId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isAdminOrSW()
        || resource.data.assignedTo == request.auth.uid
      );
      allow create: if isSignedIn() && isAdminOrSW();
      allow update: if isSignedIn() && isActiveUser() && (
        isAdminOrSW()
        || resource.data.assignedTo == request.auth.uid
      );
      allow delete: if isAdmin();

      // PDI item subcollection.
      // assignedTo is denormalized onto each item at creation so we can
      // check it directly — eliminates a get() on the parent PDI document
      // that would otherwise double the Firestore read cost per item.
      match /items/{itemId} {
        allow read: if isSignedIn() && isActiveUser() && (
          isAdminOrSW()
          || resource.data.assignedTo == request.auth.uid
        );
        allow create: if isSignedIn() && isActiveUser() && (
          isAdminOrSW()
          || request.resource.data.assignedTo == request.auth.uid
        );
        allow update: if isSignedIn() && isActiveUser() && (
          isAdminOrSW()
          || resource.data.assignedTo == request.auth.uid
        );
        allow delete: if isAdmin();
      }
    }

    // ── Item Stats (aggregated analytics) ──────────────────────────────────
    match /item_stats/{statId} {
      allow read:  if isSignedIn() && isAdmin();
      allow write: if isSignedIn() && isAdminOrSW();  // tightened from isActive()
    }

  }
}
